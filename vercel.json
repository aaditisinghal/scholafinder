{
  "buildCommand": "cd web-app && npm install && npm run build",
  "outputDirectory": "web-app/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/swipe/(.*)", "destination": "/index.html" },
    { "source": "/orchestration", "destination": "/index.html" }
  ]
}
