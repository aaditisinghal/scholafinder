# --- Gemini (boss agent + all subagent reasoning) ---
# Option A: Vertex AI via a service account (preferred — takes priority if both are set)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./secrets/scholarfinder-vertex-key.json
# Option B: plain Gemini API key (used only if the two Vertex vars above aren't set)
GEMINI_API_KEY=

# --- Swipe deck web server (boss agent links to this from iMessage) ---
WEB_PORT=3000
# Public URL the boss agent puts in the iMessage link. localhost only works if you're
# testing from the same machine — use a tunnel (ngrok/cloudflared) for a real phone.
WEB_BASE_URL=http://localhost:3000

# --- Photon / Spectrum (iMessage) ---
# From app.photon.codes project settings. Promo code HACKWITHPHOTON for a free Pro month.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# "terminal" for local dev with no phone, "imessage" for the real cloud provider.
SPECTRUM_PROVIDER=terminal

# --- Tiger Cloud Postgres ---
# postgres://user:password@host:port/dbname?sslmode=require&uselibpqcompat=true
# (the uselibpqcompat flag avoids a node-postgres v9 strict-verify quirk against Tiger Cloud's cert chain)
DATABASE_URL=

# --- ElevenLabs Conversational AI (call agent) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The phone number ID shown in the ElevenLabs dashboard after you import your Twilio
# number there (native Twilio integration) — NOT the raw phone number string.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# --- Email agent ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=scholarfinder@yourdomain.com
EMAIL_REPLY_TO_INBOX=

# --- Solana reward dispatcher (devnet only) ---
SOLANA_CLUSTER=devnet
SOLANA_REWARD_WALLET_SECRET_KEY=
SOLANA_REWARD_AMOUNT_SOL=0.01
